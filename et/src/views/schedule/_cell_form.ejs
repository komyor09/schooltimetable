<% const l1 = lessons[0] || {}; const l2 = lessons[1] || {}; %>
<div class="card border border-blue-300">
  <h3 class="font-medium mb-2"><%= t('schedule_edit_lesson') %> — <%= cls.name %>, <%= t('day_' + day) %>, № <%= lessonNumber %></h3>
  <% if (error) { %>
    <p class="text-red-600 text-sm mb-2"><%= error %></p>
  <% } %>
  <form hx-put="/schedule/cell/<%= cls.id %>/<%= day %>/<%= lessonNumber %>" hx-target="#cell-editor" hx-swap="innerHTML">
    <div class="grid grid-cols-2 gap-3 mb-3 max-w-lg">
      <div class="col-span-2">
        <label class="field-label"><%= t('curriculum_subject') %></label>
        <select name="subject_id" class="field-input">
          <option value=""><%= t('schedule_cell_empty') %></option>
          <% allSubjects.forEach(function(s) { %>
            <option value="<%= s.id %>" <%= l1.subject_id === s.id ? 'selected' : '' %>><%= s.name %></option>
          <% }); %>
        </select>
      </div>
      <label class="col-span-2 text-sm flex items-center gap-2">
        <input type="checkbox" name="is_subgroup" <%= isSubgroup ? 'checked' : '' %>
               onchange="document.getElementById('subgroup2-fields').hidden = !this.checked">
        <%= t('subgroups_enabled') %>
      </label>

      <div>
        <label class="field-label"><%= t('teachers_title') %> 1</label>
        <select name="teacher_id_1" class="field-input">
          <option value=""></option>
          <% allTeachers.forEach(function(tt) { %>
            <option value="<%= tt.id %>" <%= l1.teacher_id === tt.id ? 'selected' : '' %>><%= tt.full_name %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="field-label"><%= t('rooms_title') %> 1</label>
        <select name="room_id_1" class="field-input">
          <option value=""></option>
          <% allRooms.forEach(function(r) { %>
            <option value="<%= r.id %>" <%= l1.room_id === r.id ? 'selected' : '' %>><%= r.name %></option>
          <% }); %>
        </select>
      </div>

      <div id="subgroup2-fields" class="col-span-2 grid grid-cols-2 gap-3" <%= isSubgroup ? '' : 'hidden' %>>
        <div>
          <label class="field-label"><%= t('teachers_title') %> 2</label>
          <select name="teacher_id_2" class="field-input">
            <option value=""></option>
            <% allTeachers.forEach(function(tt) { %>
              <option value="<%= tt.id %>" <%= l2.teacher_id === tt.id ? 'selected' : '' %>><%= tt.full_name %></option>
            <% }); %>
          </select>
        </div>
        <div>
          <label class="field-label"><%= t('rooms_title') %> 2</label>
          <select name="room_id_2" class="field-input">
            <option value=""></option>
            <% allRooms.forEach(function(r) { %>
              <option value="<%= r.id %>" <%= l2.room_id === r.id ? 'selected' : '' %>><%= r.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
    </div>
    <div class="space-x-2">
      <button type="submit" class="btn"><%= t('action_save') %></button>
      <button type="button" class="btn-secondary" onclick="document.getElementById('cell-editor').innerHTML=''"><%= t('action_close') %></button>
    </div>
  </form>
</div>
